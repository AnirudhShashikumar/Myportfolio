diff --git a/src/app/NotFound.module.css b/src/app/NotFound.module.css
new file mode 100644
index 0000000..eb74b7c
--- /dev/null
+++ b/src/app/NotFound.module.css
@@ -0,0 +1,75 @@
+.page {
+  min-height: 100svh;
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  padding: clamp(1.5rem, 4vw, 4rem);
+  background: #070a0c;
+  color: #edf4f6;
+}
+
+.identity {
+  font-size: 0.8125rem;
+  font-weight: 600;
+  line-height: 1.3;
+  letter-spacing: 0.04em;
+  text-transform: uppercase;
+  text-decoration: none;
+}
+
+.message {
+  width: 100%;
+  max-width: 54rem;
+  margin-block: auto;
+  padding-block: clamp(3.5rem, 9vh, 7rem);
+}
+
+.status,
+.signature {
+  color: #8d9fa7;
+  font-family: var(--font-geist-mono), monospace;
+  font-size: 0.75rem;
+  line-height: 1.6;
+}
+
+.status {
+  margin: 0 0 1.5rem;
+  letter-spacing: 0.1em;
+  text-transform: uppercase;
+}
+
+.message h1 {
+  margin: 0;
+  font-size: clamp(3.25rem, 8vw, 7.5rem);
+  font-weight: 500;
+  line-height: 0.98;
+  letter-spacing: -0.055em;
+}
+
+.explanation {
+  max-width: 30rem;
+  margin: 1.75rem 0 2rem;
+  color: #b8c5ca;
+  font-size: 1rem;
+  line-height: 1.7;
+}
+
+.home {
+  display: inline-flex;
+  align-items: center;
+  gap: 2rem;
+  min-height: 3rem;
+  padding: 0.75rem 1.25rem;
+  border: 1px solid #728a95;
+  font-size: 0.875rem;
+  line-height: 1.4;
+  text-decoration: none;
+}
+
+.home:hover {
+  background: #17242b;
+}
+
+.signature {
+  margin: 0;
+}
